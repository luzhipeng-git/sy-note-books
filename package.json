{
  "name": "sy-note-books",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "./scripts/e2e-docker.sh",
    "test:e2e:nobuild": "./scripts/e2e-docker.sh --no-build",
    "docker:build": "docker build -t synote-tauri:deps -f src-tauri/docker/Dockerfile .",
    "docker:build:base": "docker build -t synote-tauri:base --target base -f src-tauri/docker/Dockerfile .",
    "docker:test": "docker run --rm -v $(pwd):/workspace -v synote-cargo-target:/opt/cargo-target -e CARGO_TARGET_DIR=/opt/cargo-target synote-tauri:deps sh -c \"source /root/.cargo/env && cd /workspace/src-tauri && cargo test --workspace\"",
    "docker:clean": "docker volume rm synote-pnpm-store synote-cargo-target 2>/dev/null; docker rmi synote-tauri:deps 2>/dev/null; rm -f .docker-deps-hash; echo Done"
  },
  "dependencies": {
    "@drawnix/drawnix": "0.4.0-0",
    "@floating-ui/react": "^0.27.19",
    "@plait-board/react-board": "0.4.0-0",
    "@plait-board/react-text": "0.4.0-0",
    "@plait/common": "^0.93.1",
    "@plait/core": "^0.93.1",
    "@plait/draw": "^0.93.1",
    "@plait/mind": "^0.93.1",
    "@plait/text-plugins": "^0.93.1",
    "@tauri-apps/api": "^2.11.0",
    "classnames": "^2.5.1",
    "laser-pen": "^1.0.1",
    "lodash": "^4.18.1",
    "minisearch": "^7.2.0",
    "mobile-detect": "^1.4.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "slate": "^0.124.1",
    "slate-react": "^0.124.2",
    "vditor": "^3.11.2",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.11.2",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7",
    "vite": "^8.0.0"
  }
}
