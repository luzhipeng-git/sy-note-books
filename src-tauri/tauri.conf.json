{
  "$schema": "https://raw.githubusercontent.com/nickinchris/tauri/feat-v2/examples/api/src-tauri/gen/schemas/desktop-schema.json",
  "productName": "sy-note-books",
  "version": "0.1.0",
  "identifier": "com.synote.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "书昀笔记电子书",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
